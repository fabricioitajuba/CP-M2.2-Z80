  175                   ;LC* uma tecla do teclado e retorna no
  176                   ;acumulador o byte da tecla pressionada
  177                   ;--------------------------------------
  178 0211  C5          le_tec:	push bc
  179 0212  E5          	push hl
  180 0213  0E 01       	ld c,FUNC1	;LC* uma
  181 0215  CD 0005             call BDOS	;tecla
  182 0218  E1          	pop hl
  183 0219  C1          	pop bc
  184 021A  C9          	ret
  185                   
  186                   ;--------------------------------------
  187                   ;Rotina: asciitobin
  188                   ;Retorna no acumulador o binC!rio do cC3digo
  189                   ;ASCII
  190                   ;Entrada: A = valor em ASCII
  191                   ;SaC-da: A = valor em binC!rio
  192                   ;--------------------------------------
  193 021B              asciitobin:
  194 021B  FE 3A       	cp 3ah
  195 021D  FA 0000#    	jp m,conver1
  196 0220  D6 30       	sub a,30h
  197 0222  C9          	ret
  198 0223              conver1:
  199 0223  CB AF       	res 5,a 
  200 0225  D6 37       	sub 37h
  201 0227  C9          	ret
